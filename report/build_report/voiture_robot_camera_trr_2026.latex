</style>
<script>
var engine;

function init() {
	vmax=0;
	engine=0;
	document.getElementById("on_off_button").innerHTML="Engine Off";
	document.getElementById("on_off_button").style.backgroundColor="red";

    document.getElementById("on_off_button").addEventListener("click",async function() {
        let response;
        if(this.innerHTML == "Engine Off") {
            response = await fetch('/engine_on');
            this.innerHTML = "Engine On";
            this.style.backgroundColor="green";
            engine=1;
        }	
        else {
            response = await fetch('/engine_off');
            this.innerHTML = "Engine Off";
            this.style.backgroundColor="red";
            engine=0;
        }	
    });
}

function updateData() {
    fetch('/brain')
        .then(response => response.json())
        .then(data => {
            document.getElementById('angle').textContent = data.angle;
            document.getElementById('odometre').textContent = data.odometre;
            document.getElementById('rpm').textContent = data.current_rpm;
            document.getElementById('pwm').textContent = data.current_pwm;
        });
}

setInterval(updateData, 500);

</script>
<body onload="init()">
