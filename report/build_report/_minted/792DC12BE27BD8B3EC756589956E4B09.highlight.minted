        \PYG{n}{x} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{where}\PYG{p}{(}\PYG{n}{col\PYGZus{}density}\PYG{o}{\PYGZgt{}}\PYG{l+m+mi}{50}\PYG{p}{)[}\PYG{l+m+mi}{0}\PYG{p}{]}
        \PYG{k}{if} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{x}\PYG{p}{)} \PYG{o+ow}{and} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{y}\PYG{p}{):}
            \PYG{n}{x1}\PYG{p}{,} \PYG{n}{x2} \PYG{o}{=} \PYG{n}{x}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{o}{*}\PYG{l+m+mi}{40}\PYG{p}{,} \PYG{n}{x}\PYG{p}{[}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{]}\PYG{o}{*}\PYG{l+m+mi}{40}
            \PYG{n}{y1}\PYG{p}{,} \PYG{n}{y2} \PYG{o}{=} \PYG{n}{y}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{o}{*}\PYG{l+m+mi}{40}\PYG{p}{,} \PYG{n}{y}\PYG{p}{[}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{]}\PYG{o}{*}\PYG{l+m+mi}{40}
            \PYG{n}{v0} \PYG{o}{=} \PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{vh} \PYG{o}{+} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{HEIGHT}\PYG{p}{)} \PYG{o}{//}\PYG{l+m+mi}{2}
            \PYG{k}{if} \PYG{n}{y1}\PYG{o}{\PYGZgt{}} \PYG{n}{v0} \PYG{o+ow}{and} \PYG{n}{y2} \PYG{o}{\PYGZhy{}} \PYG{n}{y1} \PYG{o}{\PYGZgt{}} \PYG{l+m+mi}{50} \PYG{o+ow}{and} \PYG{n}{x2} \PYG{o}{\PYGZhy{}} \PYG{n}{x1} \PYG{o}{\PYGZgt{}} \PYG{l+m+mi}{200}\PYG{p}{:}
                \PYG{n}{cv}\PYG{o}{.}\PYG{n}{line}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{img\PYGZus{}cam}\PYG{p}{,} \PYG{p}{(}\PYG{n}{x1}\PYG{p}{,} \PYG{n}{y1}\PYG{p}{),} \PYG{p}{(}\PYG{n}{x2}\PYG{p}{,} \PYG{n}{y2}\PYG{p}{),} \PYG{p}{(}\PYG{l+m+mi}{255}\PYG{p}{,}\PYG{l+m+mi}{255}\PYG{p}{,}\PYG{l+m+mi}{0}\PYG{p}{),} \PYG{l+m+mi}{3}\PYG{p}{)}
                \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{result}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}redline\PYGZdq{}}\PYG{p}{]}\PYG{o}{=}\PYG{l+m+mi}{1}
                \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}\PYGZgt{}\PYGZgt{}\PYGZgt{}\PYGZgt{}redline found\PYGZdq{}}\PYG{p}{)}
                \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{red\PYGZus{}line\PYGZus{}time} \PYG{o}{=} \PYG{n}{cv}\PYG{o}{.}\PYG{n}{getTickCount}\PYG{p}{()}
                \PYG{k}{return} \PYG{l+m+mi}{1}
        \PYG{k}{return} \PYG{l+m+mi}{0}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{analyse\PYGZus{}line}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,}\PYG{n}{gray}\PYG{p}{,} \PYG{n}{canny}\PYG{p}{,} \PYG{n}{v}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Cette fonction est le coeur algorithmique duu processus. Elle analyse une seule ligne horizontale d’une image pour détecter un motif précis : une zone claire entourée de deux zones sombres.  Elle commence par extraire la ligne horizontale d’indice v dans l’image des contours (Canny) et dans l’image en niveaux de gris. Elle repère ensuite les positions où des contours sont présents.}

\PYG{l+s+sd}{    Si le nombre de contours est insuffisant, elle arrête immédiatement. Les contours trop proches sont éliminés afin de supprimer le bruit.}

\PYG{l+s+sd}{    Puis, elle calcule les distances entre contours successifs et mesure la luminosité moyenne des zones comprises entre chaque paire de contours.  Elle recherche alors un motif particulier : une région très claire encadrée par deux régions sombres, avec des largeurs comparables. Cela correspond typiquement à une bande claire isolée sur un fond sombre.}

\PYG{l+s+sd}{    Si un tel motif est trouvé, la fonction calcule le centre horizontal de la zone claire en pixels, puis transforme cette position en coordonnée réelle à l’aide d’une relation géométrique (correction de perspective basée sur des paramètres de calibration). Elle retourne alors la position en pixels et la position réelle correspondante.}

\PYG{l+s+sd}{    Si aucun motif valide n’est détecté, elle renvoie une valeur indiquant l’échec.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}

        \PYG{n}{edges} \PYG{o}{=} \PYG{n}{canny}\PYG{p}{[}\PYG{n}{v}\PYG{p}{:}\PYG{n}{v}\PYG{o}{+}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{p}{:]}\PYG{o}{.}\PYG{n}{ravel}\PYG{p}{()}
        \PYG{n}{color} \PYG{o}{=} \PYG{n}{gray}\PYG{p}{[}\PYG{n}{v}\PYG{p}{:}\PYG{n}{v}\PYG{o}{+}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{p}{:]}\PYG{o}{.}\PYG{n}{ravel}\PYG{p}{()}
        \PYG{n}{bord} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{where}\PYG{p}{(}\PYG{n}{edges} \PYG{o}{==} \PYG{l+m+mi}{255}\PYG{p}{)[}\PYG{l+m+mi}{0}\PYG{p}{]}
        \PYG{k}{if} \PYG{n}{bord}\PYG{o}{.}\PYG{n}{shape}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{o}{\PYGZlt{}}\PYG{l+m+mi}{3}\PYG{p}{:} \PYG{k}{return} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{,}\PYG{l+m+mi}{0} \PYG{c+c1}{\PYGZsh{} we want to have at least 4 edges.}
        \PYG{n}{bord} \PYG{o}{=} \PYG{n}{bord}\PYG{p}{[}\PYG{n}{np}\PYG{o}{.}\PYG{n}{ediff1d}\PYG{p}{(}\PYG{n}{bord}\PYG{p}{,}\PYG{n}{to\PYGZus{}end}\PYG{o}{=}\PYG{l+m+mi}{20}\PYG{p}{)} \PYG{o}{\PYGZgt{}} \PYG{l+m+mi}{9}\PYG{p}{]} \PYG{c+c1}{\PYGZsh{} keeps only the large difference}
        \PYG{n}{delta} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{ediff1d}\PYG{p}{(}\PYG{n}{bord}\PYG{p}{)}
        \PYG{n}{mean\PYGZus{}color}\PYG{o}{=}\PYG{n}{np}\PYG{o}{.}\PYG{n}{empty}\PYG{p}{(}\PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{bord}\PYG{p}{)}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{,}\PYG{n}{dtype}\PYG{o}{=}\PYG{n+nb}{int}\PYG{p}{)}
        \PYG{k}{for} \PYG{n}{idx}\PYG{p}{,}\PYG{n}{b} \PYG{o+ow}{in} \PYG{n+nb}{enumerate}\PYG{p}{(}\PYG{n}{bord}\PYG{p}{[:}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{]):}
            \PYG{n}{mean\PYGZus{}color}\PYG{p}{[}\PYG{n}{idx}\PYG{p}{]}\PYG{o}{=}\PYG{n+nb}{int}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{mean}\PYG{p}{(}\PYG{n}{color}\PYG{p}{[}\PYG{n}{b}\PYG{p}{:}\PYG{n}{bord}\PYG{p}{[}\PYG{n}{idx}\PYG{o}{+}\PYG{l+m+mi}{1}\PYG{p}{]]))}

        \PYG{k}{for} \PYG{n}{idx} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{l+m+mi}{1}\PYG{p}{,}\PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{mean\PYGZus{}color}\PYG{p}{)}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{):}
            \PYG{k}{if} \PYG{n}{mean\PYGZus{}color}\PYG{p}{[}\PYG{n}{idx}\PYG{p}{]} \PYG{o}{\PYGZgt{}} \PYG{l+m+mi}{200} \PYG{o+ow}{and} \PYG{n}{mean\PYGZus{}color}\PYG{p}{[}\PYG{n}{idx}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{]}\PYG{o}{\PYGZlt{}}\PYG{l+m+mi}{80} \PYG{o+ow}{and} \PYG{n}{mean\PYGZus{}color}\PYG{p}{[}\PYG{n}{idx}\PYG{o}{+}\PYG{l+m+mi}{1}\PYG{p}{]}\PYG{o}{\PYGZlt{}}\PYG{l+m+mi}{80} \PYG{o+ow}{and} \PYG{n+nb}{abs}\PYG{p}{(}\PYG{n}{delta}\PYG{p}{[}\PYG{n}{idx}\PYG{p}{]}\PYG{o}{\PYGZhy{}}\PYG{n}{delta}\PYG{p}{[}\PYG{n}{idx}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{])}\PYG{o}{\PYGZlt{}}\PYG{n}{delta}\PYG{p}{[}\PYG{n}{idx}\PYG{p}{]}\PYG{o}{/}\PYG{l+m+mi}{2} \PYG{o+ow}{and} \PYG{n+nb}{abs}\PYG{p}{(}\PYG{n}{delta}\PYG{p}{[}\PYG{n}{idx}\PYG{p}{]}\PYG{o}{\PYGZhy{}}\PYG{n}{delta}\PYG{p}{[}\PYG{n}{idx}\PYG{o}{+}\PYG{l+m+mi}{1}\PYG{p}{])}\PYG{o}{\PYGZlt{}}\PYG{n}{delta}\PYG{p}{[}\PYG{n}{idx}\PYG{p}{]}\PYG{o}{/}\PYG{l+m+mi}{2}\PYG{p}{:}
                \PYG{n}{u}\PYG{o}{=}\PYG{p}{(}\PYG{n}{bord}\PYG{p}{[}\PYG{n}{idx}\PYG{p}{]}\PYG{o}{+}\PYG{n}{bord}\PYG{p}{[}\PYG{n}{idx}\PYG{o}{+}\PYG{l+m+mi}{1}\PYG{p}{])} \PYG{o}{//} \PYG{l+m+mi}{2}
                \PYG{n}{x} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{beta\PYGZus{}x} \PYG{o}{*} \PYG{p}{(}\PYG{n}{u} \PYG{o}{\PYGZhy{}}\PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{u0}\PYG{p}{)} \PYG{o}{/} \PYG{p}{(}\PYG{n}{v} \PYG{o}{\PYGZhy{}} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{vh}\PYG{p}{)}
                \PYG{k}{return} \PYG{p}{(}\PYG{n}{u}\PYG{p}{,}\PYG{n}{x}\PYG{p}{)}
        \PYG{k}{return} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{,}\PYG{l+m+mi}{0}

    \PYG{c+c1}{\PYGZsh{}@chronometre}
    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{find\PYGZus{}band}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{gray}\PYG{p}{,} \PYG{n}{canny}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{        Cette fonction cherche une ligne horizontale dans une image qui comprend une coupe de la bande noire et blanche de la piste, en explorant différentes positions verticales v.}
\PYG{l+s+sd}{        Elle :}
\PYG{l+s+sd}{            \PYGZhy{} parcourt l’image vers le haut et vers le bas à partir d’un point central,}
\PYG{l+s+sd}{            \PYGZhy{} analyse chaque ligne avec analyse\PYGZus{}line,}
\PYG{l+s+sd}{            \PYGZhy{} s’arrête dès qu’elle trouve une détection valide,}
\PYG{l+s+sd}{            \PYGZhy{} calcule ensuite une coordonnée réelle y,}
\PYG{l+s+sd}{            \PYGZhy{} retourne les informations trouvées.}
\PYG{l+s+sd}{        \PYGZdq{}\PYGZdq{}\PYGZdq{}}
        \PYG{n}{k} \PYG{o}{=} \PYG{l+m+mi}{0}
        \PYG{n}{v0} \PYG{o}{=} \PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{vh} \PYG{o}{+} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{HEIGHT}\PYG{p}{)} \PYG{o}{//}\PYG{l+m+mi}{2}
        \PYG{k}{while} \PYG{k+kc}{True}\PYG{p}{:}
            \PYG{n}{v} \PYG{o}{=} \PYG{n}{v0} \PYG{o}{+} \PYG{n}{k} \PYG{o}{*} \PYG{l+m+mi}{10}
            \PYG{k}{if} \PYG{n}{v} \PYG{o}{\PYGZgt{}=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{HEIGHT}\PYG{p}{:}
                \PYG{k}{return} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{0}
            \PYG{n}{u}\PYG{p}{,} \PYG{n}{x} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{analyse\PYGZus{}line}\PYG{p}{(}\PYG{n}{gray}\PYG{p}{,} \PYG{n}{canny}\PYG{p}{,} \PYG{n}{v}\PYG{p}{)}
            \PYG{k}{if} \PYG{n}{u} \PYG{o}{!=} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{:}
                \PYG{n}{y} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{beta\PYGZus{}y} \PYG{o}{/} \PYG{p}{(}\PYG{n}{v} \PYG{o}{\PYGZhy{}} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{vh}\PYG{p}{)}
                \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{output}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(\PYGZob{}}\PYG{l+s+s2}{\PYGZdq{}u\PYGZdq{}}\PYG{p}{:}\PYG{n}{u}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}v\PYGZdq{}}\PYG{p}{:}\PYG{n}{v}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}x\PYGZdq{}}\PYG{p}{:}\PYG{n}{x}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}y\PYGZdq{}}\PYG{p}{:}\PYG{n}{y}\PYG{p}{\PYGZcb{})}
                \PYG{k}{return} \PYG{n}{u}\PYG{p}{,} \PYG{n}{v}\PYG{p}{,} \PYG{n}{x}\PYG{p}{,} \PYG{n}{y}
            \PYG{n}{k} \PYG{o}{+=} \PYG{l+m+mi}{1}
            \PYG{n}{v} \PYG{o}{=} \PYG{n}{v0} \PYG{o}{\PYGZhy{}} \PYG{n}{k} \PYG{o}{*} \PYG{l+m+mi}{10}
            \PYG{k}{if} \PYG{n}{v} \PYG{o}{\PYGZlt{}=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{vh}\PYG{p}{:}
                \PYG{k}{return} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{0}
            \PYG{n}{u}\PYG{p}{,} \PYG{n}{x} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{analyse\PYGZus{}line}\PYG{p}{(}\PYG{n}{gray}\PYG{p}{,} \PYG{n}{canny}\PYG{p}{,} \PYG{n}{v}\PYG{p}{)}
            \PYG{k}{if} \PYG{n}{u} \PYG{o}{!=} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{:}
                \PYG{n}{y} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{beta\PYGZus{}y} \PYG{o}{/} \PYG{p}{(}\PYG{n}{v} \PYG{o}{\PYGZhy{}} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{vh}\PYG{p}{)}
                \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{output}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(\PYGZob{}}\PYG{l+s+s2}{\PYGZdq{}u\PYGZdq{}}\PYG{p}{:}\PYG{n}{u}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}v\PYGZdq{}}\PYG{p}{:}\PYG{n}{v}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}x\PYGZdq{}}\PYG{p}{:}\PYG{n}{x}\PYG{p}{,}\PYG{l+s+s2}{\PYGZdq{}y\PYGZdq{}}\PYG{p}{:}\PYG{n}{y}\PYG{p}{\PYGZcb{})}
                \PYG{k}{return} \PYG{n}{u}\PYG{p}{,} \PYG{n}{v}\PYG{p}{,} \PYG{n}{x}\PYG{p}{,} \PYG{n}{y}

    \PYG{c+c1}{\PYGZsh{}@chronometre}
    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{\PYGZus{}prepare\PYGZus{}image\PYGZus{}internal}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{img}\PYG{p}{):}
        \PYG{n}{gray} \PYG{o}{=} \PYG{n}{cv}\PYG{o}{.}\PYG{n}{cvtColor}\PYG{p}{(}\PYG{n}{img}\PYG{p}{,} \PYG{n}{cv}\PYG{o}{.}\PYG{n}{COLOR\PYGZus{}BGR2GRAY}\PYG{p}{)}
        \PYG{n}{blur}\PYG{o}{=} \PYG{n}{cv}\PYG{o}{.}\PYG{n}{GaussianBlur}\PYG{p}{(}\PYG{n}{gray}\PYG{p}{,} \PYG{p}{(}\PYG{l+m+mi}{5}\PYG{p}{,} \PYG{l+m+mi}{5}\PYG{p}{),} \PYG{l+m+mi}{0}\PYG{p}{)}
        \PYG{n}{eq} \PYG{o}{=} \PYG{n}{cv}\PYG{o}{.}\PYG{n}{equalizeHist}\PYG{p}{(}\PYG{n}{blur}\PYG{p}{)}
        \PYG{k}{return} \PYG{n}{eq}

    \PYG{c+c1}{\PYGZsh{} \PYGZhy{}\PYGZhy{}\PYGZhy{} Boucle Principale (Thread) \PYGZhy{}\PYGZhy{}\PYGZhy{}}
    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{infinite\PYGZus{}loop}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{):}
        \PYG{k}{while} \PYG{n}{rclpy}\PYG{o}{.}\PYG{n}{ok}\PYG{p}{():}
            \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{loop\PYGZus{}item}\PYG{p}{()}

    \PYG{c+c1}{\PYGZsh{}@chronometre}
    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{loop\PYGZus{}item}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{):}

        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{loop\PYGZus{}counter} \PYG{o}{+=} \PYG{l+m+mi}{1}
        \PYG{n}{frame} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{queue}\PYG{o}{.}\PYG{n}{get}\PYG{p}{()}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{result} \PYG{o}{=} \PYG{p}{\PYGZob{}\PYGZcb{}}

        \PYG{n}{prepare\PYGZus{}start} \PYG{o}{=} \PYG{n}{cv}\PYG{o}{.}\PYG{n}{getTickCount}\PYG{p}{()}
        \PYG{n}{t1} \PYG{o}{=} \PYG{n}{time}\PYG{o}{.}\PYG{n}{time}\PYG{p}{()}
        \PYG{n}{gray} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{\PYGZus{}prepare\PYGZus{}image\PYGZus{}internal}\PYG{p}{(}\PYG{n}{frame}\PYG{p}{)}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{img\PYGZus{}canny} \PYG{o}{=} \PYG{n}{cv}\PYG{o}{.}\PYG{n}{Canny}\PYG{p}{(}\PYG{n}{gray}\PYG{p}{,} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{param\PYGZus{}canny\PYGZus{}min}\PYG{p}{,} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{param\PYGZus{}canny\PYGZus{}max}\PYG{p}{)}
        \PYG{n}{prepare\PYGZus{}end} \PYG{o}{=} \PYG{n}{cv}\PYG{o}{.}\PYG{n}{getTickCount}\PYG{p}{()}

        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{output} \PYG{o}{=} \PYG{p}{[]}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{result}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}u1\PYGZdq{}}\PYG{p}{],}\PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{result}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}v1\PYGZdq{}}\PYG{p}{],}\PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{result}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}x1\PYGZdq{}}\PYG{p}{],} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{result}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}y1\PYGZdq{}}\PYG{p}{]} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{find\PYGZus{}band}\PYG{p}{(}\PYG{n}{gray}\PYG{p}{,} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{img\PYGZus{}canny}\PYG{p}{)}
